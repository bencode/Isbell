#!/usr/bin/env python3
"""Send a message to another coding agent in this herdr session, once it has stopped working.

An agent is called by its role (`isbell role`), else by its herdr name or pane ID. A prompt sent to
a busy agent interrupts or replaces its turn, so this waits for the agent to stop first. herdr
delivers text as if typed: the header added here is the only thing telling the recipient who wrote,
by its role where it has one, and how to answer.

Exit codes: 0 sent; 2 usage, not in a herdr pane, or sending to yourself; 3 the recipient is
waiting for the user; 4 timed out, the message may have been delivered, so do not resend blindly;
5 the recipient is gone, no agent runs that role now, or herdr failed.
"""

import argparse
import json
import os
import shlex
import subprocess
import sys
import time

READY = {"idle", "done"}
DEFAULT_TIMEOUT_S = 1800
CALL_TIMEOUT_S = 30
SCREEN_LINES = "120"

EXIT_USAGE = 2
EXIT_BLOCKED = 3
EXIT_TIMEOUT = 4
EXIT_FAILED = 5

# What isbell exits with for a command it does not have: one from before roles.
ISBELL_USAGE = 2

SANDBOX_HINT = (
    " If a sandbox blocked access to the herdr socket, run this command again through your"
    " approval flow, outside the sandbox."
)


class HerdrError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


class Stop(Exception):
    def __init__(self, status, message):
        super().__init__(message)
        self.status = status
        self.message = message


def run(args, timeout_s):
    try:
        return subprocess.run(
            ["herdr", *args], capture_output=True, text=True, timeout=timeout_s
        )
    except FileNotFoundError:
        raise HerdrError("not_installed", "herdr is not on PATH") from None
    except subprocess.TimeoutExpired:
        raise HerdrError("timeout", "herdr did not answer in time") from None


def failure(done):
    """The error of a failed herdr call, which is JSON from herdr and plain text from the OS."""
    text = done.stderr.strip() or done.stdout.strip()
    try:
        error = json.loads(text)["error"]
        return HerdrError(error["code"], error["message"])
    except (json.JSONDecodeError, KeyError, TypeError):
        hint = SANDBOX_HINT if "Operation not permitted" in text else ""
        return HerdrError("failed", f"{text}{hint}")


def herdr(args, timeout_s=CALL_TIMEOUT_S):
    done = run(args, timeout_s)
    if done.returncode != 0:
        raise failure(done)
    return json.loads(done.stdout)["result"]


def herdr_text(args):
    done = run(args, CALL_TIMEOUT_S)
    if done.returncode != 0:
        raise failure(done)
    return done.stdout


def isbell_error(done):
    """The error isbell gives as JSON on the last line of stderr, after any warnings."""
    lines = done.stderr.strip().splitlines()
    try:
        return json.loads(lines[-1])
    except (IndexError, json.JSONDecodeError):
        return {"code": "failed", "message": done.stderr.strip() or f"exit {done.returncode}"}


def isbell(args, expected):
    """What isbell prints as JSON, or None where it cannot tell: not installed, too old to have the
    command, or an error in `expected`. Any other failure is said on stderr, and the message goes
    by herdr's names."""
    try:
        done = subprocess.run(
            ["isbell", *args], capture_output=True, text=True, timeout=CALL_TIMEOUT_S
        )
    except FileNotFoundError:
        return None
    except subprocess.TimeoutExpired:
        print("agent-send: isbell did not answer in time; going by herdr names", file=sys.stderr)
        return None
    if done.returncode == 0:
        return json.loads(done.stdout)
    if done.returncode == ISBELL_USAGE:
        return None
    error = isbell_error(done)
    if error.get("code") not in expected:
        code, message = error.get("code"), error.get("message")
        print(f"agent-send: isbell: {code}: {message}; going by herdr names", file=sys.stderr)
    return None


def role_named(name):
    """The role of that name, with `live` while an agent runs it; None for no such role."""
    return isbell(["role", "show", name, "--limit", "1"], expected=("not_found",))


def my_role(pane_id):
    """The name of the role this session took, while it runs in this pane: only then does a reply
    to it find this agent."""
    mine = isbell(["role", "mine", "--limit", "1"], expected=("not_an_agent",))
    live = mine[0].get("live") if mine else None
    return mine[0]["name"] if live and live["pane"] == pane_id else None


def resolve(target):
    """Where a message to `target` goes, and the name of its role: a role is sent to the pane of
    the agent running it; a name that is no role is herdr's name or a pane ID, as before."""
    role = role_named(target)
    if role is None:
        return target, None
    if not role.get("live"):
        name = role["name"]
        raise Stop(EXIT_FAILED, f"no agent runs the role {name} now; it has to be resumed first")
    return role["live"]["pane"], role["name"]


def get_agent(target):
    return herdr(["agent", "get", target])["agent"]


def address(agent):
    return agent.get("name") or agent["pane_id"]


def is_ready(agent):
    return agent["agent_status"] in READY


def remaining_ms(deadline):
    return int(max(deadline - time.monotonic(), 0) * 1000)


def await_ready(target, role, deadline):
    while True:
        agent = get_agent(target)
        if is_ready(agent):
            return agent
        who = role or address(agent)
        if agent["agent_status"] == "blocked":
            raise Stop(EXIT_BLOCKED, f"{who} is waiting for the user; nothing was sent")
        left = remaining_ms(deadline)
        if left == 0:
            raise Stop(EXIT_TIMEOUT, f"{who} did not stop in time; nothing was sent")
        try:
            herdr(["agent", "wait", target, "--timeout", str(left)], left / 1000 + CALL_TIMEOUT_S)
        except HerdrError as error:
            if error.code != "timeout":
                raise


def format_message(sender, recipient, body, reply_command):
    lines = [
        f"[agent-talk] From: {sender} · To: {recipient} (that is you)",
        "Sent through herdr by another agent on this machine.",
        "",
        body,
    ]
    if reply_command:
        lines += ["", f"To reply, run: {reply_command}"]
    return "\n".join(lines)


def reply_command(sender):
    script = shlex.quote(os.path.realpath(__file__))
    return f'{script} {shlex.quote(sender)} "<your reply>"'


def send_and_wait(pane, recipient, text, deadline):
    left = remaining_ms(deadline)
    result = herdr(
        ["agent", "prompt", pane, text, "--wait", "--timeout", str(left)],
        left / 1000 + CALL_TIMEOUT_S,
    )
    screen = herdr_text(
        ["agent", "read", pane, "--source", "recent-unwrapped", "--lines", SCREEN_LINES]
    )
    print(screen, end="")
    if result["agent"]["agent_status"] == "blocked":
        raise Stop(EXIT_BLOCKED, f"{recipient} is waiting for the user")


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="agent-send", description="Send a message to another agent in this herdr session."
    )
    parser.add_argument("target", help="the agent's role, or its herdr name or pane ID")
    parser.add_argument("message", help="the message, or - to read it from stdin")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--reply", action="store_true", help="ask the agent to reply to you")
    mode.add_argument("--wait", action="store_true", help="wait and print what the agent shows")
    parser.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT_S, metavar="SECONDS")
    return parser.parse_args(argv)


def send(args, pane_id):
    deadline = time.monotonic() + args.timeout
    body = sys.stdin.read() if args.message == "-" else args.message
    if not body.strip():
        raise Stop(EXIT_USAGE, "the message is empty")
    # herdr first: where it cannot be reached, isbell sees no agent running and could not say why.
    me = get_agent(pane_id)
    target, role = resolve(args.target)
    if get_agent(target)["pane_id"] == me["pane_id"]:
        raise Stop(EXIT_USAGE, "that is you; pick another agent")
    agent = await_ready(target, role, deadline)
    pane = agent["pane_id"]
    recipient = role or address(agent)
    # By its role, a reply finds the sender even once its session is resumed in another pane.
    sender = my_role(me["pane_id"]) or address(me)
    text = format_message(sender, recipient, body, reply_command(sender) if args.reply else None)
    if args.wait:
        send_and_wait(pane, recipient, text, deadline)
        return
    herdr(["agent", "prompt", pane, text])
    print(f"sent to {recipient}")


def status_of(error):
    if error.code == "agent_blocked":
        return EXIT_BLOCKED
    if error.code in ("timeout", "agent_prompt_stalled"):
        return EXIT_TIMEOUT
    return EXIT_FAILED


def main(argv):
    args = parse_args(argv)
    pane_id = os.environ.get("HERDR_PANE_ID")
    if not pane_id:
        print("agent-send: not running inside a herdr pane", file=sys.stderr)
        return EXIT_USAGE
    try:
        send(args, pane_id)
    except Stop as stop:
        print(f"agent-send: {stop.message}", file=sys.stderr)
        return stop.status
    except HerdrError as error:
        print(f"agent-send: {error.code}: {error.message}", file=sys.stderr)
        return status_of(error)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
