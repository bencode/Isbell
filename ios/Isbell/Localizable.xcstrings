    "Run `isbell gateway` on a machine to bring it here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在机器上运行 `isbell gateway`，它就会出现在这里。"
          }
        }
      }
    },
    "Run these two on a machine with herdr installed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在装了 herdr 的机器上运行这两行命令。"
          }
        }
      }
    },
    "Running": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
