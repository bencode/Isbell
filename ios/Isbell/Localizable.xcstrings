          }
        }
      }
    },
    "Standing by": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待命"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统"
          }
        }
      }
    },
    "That is not a whole key. Check for a missing character.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是一个完整的密钥，请检查是否少了字符。"
          }
        }
      }
    },
    "That key failed its checksum. Check for a mistyped character.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥校验没通过，请检查是否有字符打错。"
          }
        }
      }
    },
    "The key is complete.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥完整。"
          }
        }
      }
    },
    "The key is kept only on this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥只存在这台 iPhone。"
          }
        }
      }
    },
    "The key is removed from this iPhone. You can join again with the same key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥会从这台 iPhone 上删除。之后可以用同一个密钥重新加入。"
          }
        }
      }
    },
    "The key stays in this iPhone's Keychain and on your machines. There is no account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥只存在这台 iPhone 的钥匙串和你的机器上，没有账号。"
          }
        }
      }
    },
    "The machine is offline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台机器离线"
          }
        }
      }
    },
    "The relay did not accept this key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "relay 没有接受这个密钥。"
          }
        }
      }
    },
    "The sessions your agents run on your machines show up here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的机器上 agent 跑着的 session 会出现在这里。"
